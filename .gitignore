# логи прогонов
logs/*
!logs/.gitkeep
# рабочий scratch агентов: пробы, оракулы гейта, локальные логи (остаются на диске как референс, в репо не нужны)
context/**/tmp/
context/logs/
# нативные git-worktree напарников (isolation:"worktree") — Claude Code кладёт их сюда; в репо не нужны
.claude/worktrees/
# бинарные тестовые артефакты рендеров (грузятся по запросу, не в репо системы)
renders/*.png
# рендеры concept-artist — бинарь регенерится из исходного .html через Edge, в репо не кладём
concept-art/*.png
# локальные настройки и секреты
.claude/settings.local.json
# маркер QA-гейта — локальный, создаётся game-lead вручную, не коммитится
.claude/QA_OK
# рантайм-лог хука инъекции маяка — растёт каждый ход, не коммитится
.claude/hooks/gate-inject.log
*.key
*.keys.json
.env
# крупные/сырые материалы проекта (грузятся по запросу, не в репо системы)
*.docx
*.pdf
*.xlsx
# исключение: плановая таблица Рината — рабочий документ, ведёт game-lead (директива 07-02)
!docs/contrary-survivor/DemoPlanTemplateRec.xlsx

# local asset backups (orphans etc.) — not for VCS
backups/
# Blender авто-бэкапы (.blend1) — мусор, не версионируем
*.blend1

# game-lead служебные watcher-скрипты и временные (не в git)
reports/Agents/_gl_*.sh
reports/Agents/*.tmp
reports/Agents/*.bak
reports/Agents/*.bak.*
reports/Agents/HEARTBEAT.md
reports/Agents/STATUS_PULSE.txt
reports/Agents/gl_heartbeat_status.txt
